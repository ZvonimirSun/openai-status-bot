{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openai-codex-status-wecom",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "STATUS_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
