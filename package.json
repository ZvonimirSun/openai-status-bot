{
  "name": "openai-codex-status-wecom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --test-scheduled",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/deploy.test.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check",
    "cf-typegen": "wrangler types --config wrangler.local.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.7",
    "esbuild": "0.28.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
